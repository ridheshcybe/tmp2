# ══════════════════════════════════════════════════════════════════════════════
# Aero Piston Engine Digital Twin - Backend Configuration
# ══════════════════════════════════════════════════════════════════════════════

# ─── WebSocket Configuration ──────────────────────────────────────────────────
# Port for incoming AI telemetry stream (from Python ai_service.py)
AI_STREAM_PORT=8766

# Port for outgoing client broadcast (to React dashboard)
CLIENT_WS_PORT=8080

# ─── Database Configuration ───────────────────────────────────────────────────
# PostgreSQL/TimescaleDB connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/aerotwin

# ─── Logging Configuration ────────────────────────────────────────────────────
# Directory for log files
LOG_DIR=./logs

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ─── Simulation Configuration ─────────────────────────────────────────────────
# Simulation frequency in Hz (must match Python telemetry_streamer.py)
SIMULATION_HZ=10

# ─── Data Paths ───────────────────────────────────────────────────────────────
# Directory containing generated CSV datasets
DATA_DIR=./data

# ─── Frontend Configuration ───────────────────────────────────────────────────
# React development server URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ─── Production Settings ──────────────────────────────────────────────────────
# Set to true in production deployments
NODE_ENV=development

# Session secret for any authentication middleware
SESSION_SECRET=change-me-in-production
