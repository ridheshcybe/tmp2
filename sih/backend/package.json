{
  "name": "aerotwin-backend",
  "version": "1.0.0",
  "description": "Aero Piston Engine Digital Twin — Node.js Backend Gateway",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "server": "tsx src/server.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:client": "node backend_test_client.js",
    "test:phase4": "tsx tests/test_phase4.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "pg": "^8.13.0",
    "pg-promise": "^11.10.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.1.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "csv-writer": "^1.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@types/pg": "^8.11.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "AeroTwin Team",
  "license": "MIT"
}
